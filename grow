    print(f"  {CYAN}grow user set <name>{RESET}     Set device user in `data/config.json` (`{PERSISTED_USER}` persists in Git)")
    print(f"  {CYAN}grow sync{RESET}                Pull & push `{PERSISTED_USER}` progress (`data/users/{PERSISTED_USER}.json`) via Git")

    print(f"\n{BOLD}{BLUE}ROADMAP & HISTORY{RESET}")
    print(f"  {CYAN}grow roadmap{RESET}             View the full multi-month syllabus, weekly breakdown & core books")
    print(f"  {CYAN}grow log{RESET}                 View your full history of daily check-ins, test scores, XP & notes")
    print(f"  {CYAN}grow check-videos{RESET}        Verify all daily video URLs are real, live YouTube videos")

    print(f"\n{BOLD}{BLUE}MULTI-TRACK MANAGEMENT (LEARN ANYTHING){RESET}")
    print(f"  {CYAN}grow track list{RESET}          List all learning tracks and see which one is active")
    print(f"  {CYAN}grow track switch <id>{RESET}   Switch active track (e.g., `grow track switch devops`)")
    print(f"  {CYAN}grow track create <id> \"<Title>\" [--months N]{RESET}")
    print(f"                           Create a brand-new learning track for a future topic")

    print(f"\n{BOLD}{BLUE}HELP & OPTIONS{RESET}")
    print(f"  {CYAN}grow help [command]{RESET}      Show this command guide (or detailed flags for a specific command)")
    print(f"  {CYAN}grow -h{RESET} / {CYAN}grow --help{RESET}    Standard CLI help flags\n")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="grow",
        description="Terminal Learning, Hands-On Lab Grader & Daily Accountability Engine",
    )
    sub = parser.add_subparsers(dest="command")

    sub.add_parser("status", help="Show accountability dashboard, streak, heatmap & module progress")
    sub.add_parser("roadmap", help="Display the full multi-month syllabus & recommended books")

    p_lesson = sub.add_parser("lesson", help="Read today's concept, cheat sheet, book chapter, video & lab")
    p_lesson.add_argument("day", nargs="?", type=int, help="Specific day number (defaults to current day)")

    p_lab = sub.add_parser("lab", help="Initialize the hands-on terminal lab sandbox for the day")
    p_lab.add_argument("day", nargs="?", type=int, help="Specific day number (defaults to current day)")

    p_verify = sub.add_parser("verify", help="Run automated verification checks on your hands-on lab")
    p_verify.add_argument("day", nargs="?", type=int, help="Specific day number (defaults to current day)")

    p_test = sub.add_parser("test", help="Run lab verification + interactive terminal quiz to complete the day")
    p_test.add_argument("day", nargs="?", type=int, help="Specific day number (defaults to current day)")
    p_test.add_argument("--skip-lab", action="store_true", help="Run quiz only (not recommended)")

    sub.add_parser("log", help="View your daily check-in history, scores, streaks & reflections")
    sub.add_parser("check-videos", help="Verify all daily video links are real, live YouTube URLs")

    p_user = sub.add_parser("user", help=f"Configure active user (`{PERSISTED_USER}` is Git-persisted; others are local-only)")
    p_user.add_argument("user_action", nargs="?", choices=["status", "set"], default="status")
    p_user.add_argument("username", nargs="?", help=f"Username to set (use `{PERSISTED_USER}` for cross-device Git sync)")
    p_user.add_argument("--auto-sync", dest="auto_sync", action="store_true", default=None, help="Auto-commit & push on day completion")
    p_user.add_argument("--no-auto-sync", dest="auto_sync", action="store_false", help="Disable auto-sync on day completion")

    sub.add_parser("sync", help=f"Sync `{PERSISTED_USER}` progress across devices via Git pull/commit/push")

    p_track = sub.add_parser("track", help="Manage multiple learning tracks (devops, rust, system-design, etc.)")
    p_track.add_argument("track_action", nargs="?", choices=["list", "switch", "create"], default="list")
    p_track.add_argument("id", nargs="?", help="Track slug ID")
    p_track.add_argument("title", nargs="?", help="Track title (when creating)")
    p_track.add_argument("--months", type=int, default=3, help="Target months for new track")

    p_help = sub.add_parser("help", help="Show detailed command guide and options")
    p_help.add_argument("topic", nargs="?", help="Optional command name to inspect (e.g., `grow help track`)")

    return parser


def main() -> None:
    parser = build_parser()
    args = parser.parse_args()
    cmd = args.command or "status"

    dispatch = {
        "status": cmd_status,
        "roadmap": cmd_roadmap,
        "lesson": cmd_lesson,
        "lab": cmd_lab,
        "verify": cmd_verify,
        "test": cmd_test,
        "log": cmd_log,
        "check-videos": cmd_check_videos,
        "user": cmd_user,
        "sync": cmd_sync,
        "track": cmd_track,
        "help": cmd_help,
    }
    dispatch[cmd](args)


if __name__ == "__main__":
    main()
