def setup_lab_sandbox(track_id: str, day_num: int, day_data: dict) -> Path:
    sandbox = WORKSPACE_DIR / track_id / f"day-{day_num:03d}"
    if sandbox.exists():
        shutil.rmtree(sandbox)
    sandbox.mkdir(parents=True, exist_ok=True)

    lab = day_data.get("lab", {})
    for item in lab.get("setup_files", []):
        target = sandbox / item["path"]
        target.parent.mkdir(parents=True, exist_ok=True)
        if "symlink_to" in item:
            if target.exists() or target.is_symlink():
                target.unlink()
            os.symlink(item["symlink_to"], target)
            continue

        content = item.get("content", "")
        repeat = item.get("repeat", 1)
        with open(target, "w", encoding="utf-8") as f:
            f.write(content * repeat)

        if "mode" in item:
            os.chmod(target, item["mode"])

    return sandbox


