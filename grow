def print_wrapped(text: str, indent: str = "  ", width: int = 88) -> None:
    for line in text.split("\n"):
        if not line.strip():
            print()
            continue
        wrapped = textwrap.fill(
            line,
            width=width,
            initial_indent=indent,
            subsequent_indent=indent + "   " if line.lstrip().startswith(("-", "•", "1.", "2.", "3.", "4.", "5.")) else indent,
        )
        print(wrapped)


