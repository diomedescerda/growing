def today_str() -> str:
    return datetime.date.today().isoformat()


def sanitize_username(name: str) -> str:
    cleaned = re.sub(r"[^a-z0-9_-]", "", (name or "").strip().lower())
    return cleaned or DEFAULT_USER


def load_config() -> dict:
    if CONFIG_FILE.exists():
        try:
            with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                data = json.load(f)
                if isinstance(data, dict):
                    return data
        except Exception:
            pass
    return {"user": DEFAULT_USER, "auto_sync": False}


def save_config(cfg: dict) -> None:
    CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
    with open(CONFIG_FILE, "w", encoding="utf-8") as f:
        json.dump(cfg, f, indent=2)


def get_active_user() -> str:
    env_user = os.environ.get("GROW_USER")
    if env_user:
        return sanitize_username(env_user)
    cfg = load_config()
    return sanitize_username(cfg.get("user", DEFAULT_USER))


def is_persisted_user(user: str | None = None) -> bool:
    u = sanitize_username(user) if user else get_active_user()
    return u == PERSISTED_USER


def get_state_file(user: str | None = None) -> Path:
    u = sanitize_username(user) if user else get_active_user()
    return USERS_DIR / f"{u}.json"


def load_state() -> dict:
    state_file = get_state_file()
    if not state_file.exists():
        state_file.parent.mkdir(parents=True, exist_ok=True)
        if LEGACY_DATA_FILE.exists():
            with open(LEGACY_DATA_FILE, "r", encoding="utf-8") as f:
                legacy_state = json.load(f)
            save_state(legacy_state)
            return legacy_state
        default_state = {
            "active_track": "devops",
            "created_at": today_str(),
            "tracks": {
                "devops": {
                    "current_day": 1,
                    "started_at": today_str(),
                    "last_checkin_date": None,
                    "current_streak": 0,
                    "longest_streak": 0,
                    "xp": 0,
                    "completed_days": {},
                    "daily_logs": [],
                }
            },
        }
        save_state(default_state)
        return default_state
    with open(state_file, "r", encoding="utf-8") as f:
        return json.load(f)


def save_state(state: dict) -> None:
    state_file = get_state_file()
    state_file.parent.mkdir(parents=True, exist_ok=True)
    with open(state_file, "w", encoding="utf-8") as f:
        json.dump(state, f, indent=2)


def get_active_track_And_progress(state: dict) -> tuple[str, dict, dict]:
    track_id = state.get("active_track", "devops")
    track_file = TRACKS_DIR / track_id / "track.json"
    if not track_file.exists():
        print(f"{RED}Error: Track '{track_id}' not found at {track_file}{RESET}")
        sys.exit(1)
    with open(track_file, "r", encoding="utf-8") as f:
        track_meta = json.load(f)
    if track_id not in state["tracks"]:
        state["tracks"][track_id] = {
            "current_day": 1,
            "started_at": today_str(),
            "last_checkin_date": None,
            "current_streak": 0,
            "longest_streak": 0,
            "xp": 0,
            "completed_days": {},
            "daily_logs": [],
        }
        save_state(state)
    return track_id, track_meta, state["tracks"][track_id]


def load_day(track_id: str, day_num: int) -> dict | None:
    day_file = TRACKS_DIR / track_id / "days" / f"day-{day_num:03d}.json"
    if not day_file.exists():
        return None
    with open(day_file, "r", encoding="utf-8") as f:
        return json.load(f)


def progress_bar(done: int, total: int, width: int = 24) -> str:
    total = max(total, 1)
    ratio = min(max(done / total, 0.0), 1.0)
    filled = int(round(ratio * width))
    bar = f"{GREEN}{'█' * filled}{DIM}{'░' * (width - filled)}{RESET}"
    pct = ratio * 100
    return f"[{bar}] {done}/{total} ({pct:.1f}%)"


def evaluate_accountability(progress: dict) -> tuple[str, int]:
    """Returns an accountability banner and effective current streak."""
    last_str = progress.get("last_checkin_date")
    streak = progress.get("current_streak", 0)
    today = datetime.date.today()

    if not last_str:
        return (
            f"{YELLOW}⚡ DAY 1 AWAITS: You haven't logged your first check-in yet. Start today with `grow lesson`!{RESET}",
            0,
        )

    last_date = datetime.date.fromisoformat(last_str)
    delta = (today - last_date).days

    if delta == 0:
        return (
            f"{GREEN}✅ ACCOUNTABILITY CHECK PASSED: You showed up today ({today_str()})! Streak: {streak} day(s) 🔥{RESET}",
            streak,
        )
    elif delta == 1:
        return (
            f"{YELLOW}⏳ DUE TODAY: Last check-in was yesterday ({last_str}). Pass today's test to hit {streak + 1} days in a row! 🔥{RESET}",
            streak,
        )
    elif delta > 1:
        missed = delta - 1
        return (
            f"{RED}🚨 ACCOUNTABILITY ALERT: You missed {missed} day(s) since {last_str}! Your {streak}-day streak was broken. Rebuild it TODAY!{RESET}",
            0,
        )
    else:
        return (f"{GREEN}✅ Last check-in: {last_str} (Streak: {streak} 🔥){RESET}", streak)


def render_heatmap(progress: dict, days_to_show: int = 28) -> str:
    today = datetime.date.today()
    logged_dates = {entry["date"] for entry in progress.get("daily_logs", [])}
    started_str = progress.get("started_at", today.isoformat())
    try:
        started_date = datetime.date.fromisoformat(started_str)
    except ValueError:
        started_date = today

    cells = []
    for offset in range(days_to_show - 1, -1, -1):
        d = today - datetime.timedelta(days=offset)
        d_str = d.isoformat()
        if d_str in logged_dates:
            cells.append(f"{GREEN}■{RESET}")
        elif d == today:
            cells.append(f"{YELLOW}▣{RESET}")
        elif d < started_date:
            cells.append(f"{DIM}·{RESET}")
        else:
            cells.append(f"{RED}□{RESET}")
    legend = f"({GREEN}■{RESET}=Done  {YELLOW}▣{RESET}=Today  {RED}□{RESET}=Missed  {DIM}·{RESET}=Pre-start)"
    return " ".join(cells) + f"  {DIM}{legend}{RESET}"


def find_module_for_day(track_meta: dict, day_num: int) -> dict | None:
    for m in track_meta.get("modules", []):
        if m["start_day"] <= day_num <= m["end_day"]:
            return m
    return track_meta.get("modules", [None])[-1]


