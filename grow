def run_verifications(track_id: str, day_num: int, day_data: dict) -> tuple[bool, list[tuple[bool, str, str]]]:
    sandbox = WORKSPACE_DIR / track_id / f"day-{day_num:03d}"
    verifications = day_data.get("lab", {}).get("verifications", [])
    results: list[tuple[bool, str, str]] = []

    if not sandbox.exists():
        return False, [(False, "Sandbox directory exists", f"Missing `{sandbox.relative_to(ROOT_DIR)}` — run `grow lab {day_num}` first.")]

    for v in verifications:
        desc = v.get("description", "Verification check")
        vtype = v.get("type")
        try:
            if vtype == "file_exact_lines":
                p = sandbox / v["path"]
                if not p.exists():
                    results.append((False, desc, f"File `{v['path']}` does not exist."))
                    continue
                actual = [line.strip() for line in p.read_text(encoding="utf-8").splitlines() if line.strip()]
                expected = [line.strip() for line in v["expected_lines"]]
                if actual == expected:
                    results.append((True, desc, "Matched exact expected lines."))
                else:
                    results.append((False, desc, f"Expected {len(expected)} specific lines in `{v['path']}`, got {len(actual)} lines."))

            elif vtype == "file_line_count":
                p = sandbox / v["path"]
                if not p.exists():
                    results.append((False, desc, f"File `{v['path']}` does not exist."))
                    continue
                lines = [line for line in p.read_text(encoding="utf-8").splitlines() if line.strip()]
                if len(lines) == v["expected_count"]:
                    results.append((True, desc, f"Found all {len(lines)} lines."))
                else:
                    results.append((False, desc, f"Expected {v['expected_count']} lines in `{v['path']}`, found {len(lines)}."))

            elif vtype == "file_trimmed_equals":
                p = sandbox / v["path"]
                if not p.exists():
                    results.append((False, desc, f"File `{v['path']}` does not exist."))
                    continue
                actual = p.read_text(encoding="utf-8").strip()
                expected = str(v["expected"]).strip()
                if actual == expected:
                    results.append((True, desc, f"Value `{actual}` matches."))
                else:
                    results.append((False, desc, f"Expected `{expected}` in `{v['path']}`, got `{actual}`."))

            elif vtype == "file_contains":
                p = sandbox / v["path"]
                if not p.exists():
                    results.append((False, desc, f"File `{v['path']}` does not exist."))
                    continue
                actual = p.read_text(encoding="utf-8")
                if v["expected_substring"] in actual:
                    results.append((True, desc, f"Found `{v['expected_substring']}`."))
                else:
                    results.append((False, desc, f"Substring `{v['expected_substring']}` not found in `{v['path']}`."))

            elif vtype == "file_contains_all":
                p = sandbox / v["path"]
                if not p.exists():
                    results.append((False, desc, f"File `{v['path']}` does not exist."))
                    continue
                actual = p.read_text(encoding="utf-8")
                missing = [s for s in v["substrings"] if s not in actual]
                if not missing:
                    results.append((True, desc, "All expected entries present."))
                else:
                    results.append((False, desc, f"Missing entries in `{v['path']}`: {', '.join(missing)}"))

            elif vtype == "symlink_resolves_content":
                p = sandbox / v["path"]
                if not p.exists():
                    results.append((False, desc, f"Path `{v['path']}` does not exist or symlink is broken."))
                    continue
                actual = p.read_text(encoding="utf-8").strip()
                if actual == v["expected"]:
                    results.append((True, desc, f"Resolved content `{actual}`."))
                else:
                    results.append((False, desc, f"Expected `{v['expected']}`, got `{actual}`."))

            elif vtype == "same_inode":
                p1 = sandbox / v["path1"]
                p2 = sandbox / v["path2"]
                if not p1.exists() or not p2.exists():
                    results.append((False, desc, f"Both `{v['path1']}` and `{v['path2']}` must exist."))
                    continue
                if p2.is_symlink():
                    results.append((False, desc, f"`{v['path2']}` is a symbolic link, not a hard link!"))
                    continue
                ino1 = os.stat(p1).st_ino
                ino2 = os.stat(p2).st_ino
                if ino1 == ino2:
                    results.append((True, desc, f"Both share inode #{ino1}."))
                else:
                    results.append((False, desc, f"Inodes differ ({ino1} vs {ino2}) — use `ln` without `-s`."))

            elif vtype == "matches_file_inode":
                p = sandbox / v["path"]
                target = sandbox / v["target_file"]
                if not p.exists() or not target.exists():
                    results.append((False, desc, f"Missing `{v['path']}` or `{v['target_file']}`."))
                    continue
                expected_ino = str(os.stat(target).st_ino)
                actual = p.read_text(encoding="utf-8").strip()
                if actual == expected_ino:
                    results.append((True, desc, f"Inode {expected_ino} verified."))
                else:
                    results.append((False, desc, f"Expected inode `{expected_ino}`, found `{actual}`."))

            elif vtype == "file_mode":
                p = sandbox / v["path"]
                if not p.exists():
                    results.append((False, desc, f"Path `{v['path']}` does not exist."))
                    continue
                mode_oct = oct(stat.S_IMODE(os.lstat(p).st_mode))[2:]
                expected_oct = str(v["expected_octal"]).lstrip("0") or "0"
                if mode_oct == expected_oct:
                    results.append((True, desc, f"Octal mode `{mode_oct}` verified."))
                else:
                    results.append((False, desc, f"Expected octal mode `{expected_oct}`, found `{mode_oct}` on `{v['path']}`."))

            elif vtype == "no_empty_files_and_min_files":
                d = sandbox / v["dir"]
                if not d.exists():
                    results.append((False, desc, f"Directory `{v['dir']}` missing."))
                    continue
                files = [f for f in d.rglob("*") if f.is_file()]
                empty_files = [str(f.relative_to(sandbox)) for f in files if f.stat().st_size == 0]
                if empty_files:
                    results.append((False, desc, f"Found {len(empty_files)} empty file(s) still remaining: {', '.join(empty_files)}"))
                elif len(files) < v.get("expected_file_count", 1):
                    results.append((False, desc, f"Too many files deleted! Expected {v['expected_file_count']} non-empty files remaining, found {len(files)}."))
                else:
                    results.append((True, desc, f"0 empty files remaining; all {len(files)} valid files preserved."))

            elif vtype == "valid_tar_gz":
                p = sandbox / v["path"]
                if not p.exists():
                    results.append((False, desc, f"Archive `{v['path']}` does not exist."))
                    continue
                if not tarfile.is_tarfile(p):
                    results.append((False, desc, f"`{v['path']}` is not a valid tar archive."))
                    continue
                with tarfile.open(p, "r:gz") as tf:
                    names = tf.getnames()
                if len(names) > 0:
                    results.append((True, desc, f"Valid `.tar.gz` archive with {len(names)} entries."))
                else:
                    results.append((False, desc, "Archive is empty."))

            elif vtype == "no_matching_files":
                d = sandbox / v["dir"]
                ext = v["extension"]
                bad = [str(f.relative_to(sandbox)) for f in d.rglob(f"*{ext}")] if d.exists() else []
                if not bad:
                    results.append((True, desc, f"No `*{ext}` files remaining."))
                else:
                    results.append((False, desc, f"Found remaining `*{ext}` files: {', '.join(bad)}"))

            else:
                results.append((True, desc, "Custom check passed."))
        except Exception as exc:
            results.append((False, desc, f"Check error: {exc}"))

    all_passed = all(r[0] for r in results) and len(results) > 0
    return all_passed, results


