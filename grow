def record_completion(state: dict, track_id: str, day_num: int, quiz_score: int, note: str) -> None:
    progress = state["tracks"][track_id]
    today = datetime.date.today()
    today_iso = today.isoformat()
    last_str = progress.get("last_checkin_date")

    if not last_str:
        progress["current_streak"] = 1
    else:
        last_date = datetime.date.fromisoformat(last_str)
        delta = (today - last_date).days
        if delta == 0:
            progress["current_streak"] = max(progress.get("current_streak", 1), 1)
        elif delta == 1:
            progress["current_streak"] = progress.get("current_streak", 0) + 1
        else:
            progress["current_streak"] = 1

    progress["longest_streak"] = max(progress.get("longest_streak", 0), progress["current_streak"])
    progress["last_checkin_date"] = today_iso

    already_completed = str(day_num) in progress["completed_days"]
    xp_earned = 25 if already_completed else 100 + (20 if quiz_score == 100 else 0)
    progress["xp"] = progress.get("xp", 0) + xp_earned

    progress["completed_days"][str(day_num)] = {
        "completed_at": today_iso,
        "quiz_score": quiz_score,
        "lab_verified": True,
        "note": note,
    }
    progress["daily_logs"].append(
        {
            "date": today_iso,
            "day": day_num,
            "quiz_score": quiz_score,
            "xp_earned": xp_earned,
            "streak": progress["current_streak"],
            "note": note,
        }
    )

    if progress["current_day"] == day_num:
        progress["current_day"] = day_num + 1

    save_state(state)
    if is_persisted_user() and load_config().get("auto_sync", True):
        sync_persisted_state(pull_first=False, commit_msg=f"chore(progress): {PERSISTED_USER} completed {track_id} day {day_num:03d}")


def cmd_test(args: argparse.Namespace) -> None:
    state = load_state()
    track_id, track_meta, progress = get_active_track_And_progress(state)
    day_num = args.day if args.day else progress["current_day"]
    day_data = load_day(track_id, day_num)
    if not day_data:
        print(f"{RED}Day {day_num} lesson file not found.{RESET}")
        sys.exit(1)

    print(f"\n{BOLD}{BG_CYAN} DAY {day_num:03d} — END-OF-DAY ACCOUNTABILITY ASSESSMENT {RESET}")
    print(f"{BOLD}Topic:{RESET} {day_data['title']}\n")

    print(f"{BOLD}{BLUE}Part 1/2: Automated Practical Lab Verification{RESET}")
    lab_passed, results = run_verifications(track_id, day_num, day_data)
    for ok, desc, detail in results:
        icon = f"{GREEN}[PASS]{RESET}" if ok else f"{RED}[FAIL]{RESET}"
        print(f"  {icon} {desc} ({DIM}{detail}{RESET})")

    if not lab_passed and not args.skip_lab:
        print(f"\n{RED}❌ Your hands-on lab in `workspace/{track_id}/day-{day_num:03d}` is not passing yet.{RESET}")
        print(f"Complete the terminal lab first (`grow lab {day_num}` -> solve -> `grow verify {day_num}`), then re-run `grow test {day_num}`.\n")
        sys.exit(1)

    quiz = day_data.get("quiz", [])
    print(f"\n{BOLD}{BLUE}Part 2/2: Interactive Terminal Concept & Scenario Quiz ({len(quiz)} Questions){RESET}")
    print(f"{DIM}Passing threshold: {track_meta.get('passing_score_percent', 80)}%+{RESET}\n")

    correct = 0
    for idx, q in enumerate(quiz, start=1):
        print(f"{BOLD}{YELLOW}Q{idx}/{len(quiz)}:{RESET} {BOLD}{q['question']}{RESET}")
        for opt in q["options"]:
            print(f"  {opt}")
        while True:
            try:
                ans = input(f"\n  {CYAN}Your answer (A/B/C/D): {RESET}").strip().upper()
            except (EOFError, KeyboardInterrupt):
                print(f"\n{YELLOW}Quiz aborted.{RESET}")
                sys.exit(1)
            if ans in ("A", "B", "C", "D"):
                break
            print(f"  {RED}Please enter A, B, C, or D.{RESET}")

        expected = q["answer"].strip().upper()
        if ans == expected:
            correct += 1
            print(f"  {GREEN}✔ Correct!{RESET} {DIM}{q['explanation']}{RESET}\n")
        else:
            print(f"  {RED}✘ Incorrect (Correct: {expected}).{RESET} {DIM}{q['explanation']}{RESET}\n")

    score_pct = int(round((correct / max(len(quiz), 1)) * 100))
    required_pct = track_meta.get("passing_score_percent", 80)

    print(f"{BOLD}── ASSESSMENT RESULTS ────────────────────────────────────────────────────{RESET}")
    print(f"  Practical Lab: {GREEN}PASSED{RESET}")
    print(f"  Quiz Score:    {BOLD}{score_pct}%{RESET} ({correct}/{len(quiz)} correct, required: {required_pct}%)")

    if score_pct < required_pct:
        print(f"\n{RED}❌ Almost there! You scored {score_pct}%, which is below the {required_pct}% mastery bar.{RESET}")
        print(f"Review the explanations above or `grow lesson {day_num}` and run `grow test {day_num}` again!\n")
        sys.exit(1)

    try:
        note = input(f"\n{CYAN}📝 Write a 1-line takeaway from today's lesson (or press Enter): {RESET}").strip()
    except (EOFError, KeyboardInterrupt):
        note = ""
    if not note:
        note = f"Completed Day {day_num}: {day_data['title']}"

    record_completion(state, track_id, day_num, score_pct, note)
    updated_progress = state["tracks"][track_id]
    print(f"\n{BG_GREEN} 🏆 DAY {day_num:03d} COMPLETE & LOGGED! {RESET}")
    print(
        f"  🔥 {BOLD}Streak:{RESET} {updated_progress['current_streak']} day(s)  |  "
        f"⚡ {BOLD}Total XP:{RESET} {updated_progress['xp']}  |  "
        f"🔓 {BOLD}Unlocked:{RESET} Day {updated_progress['current_day']}\n"
    )


