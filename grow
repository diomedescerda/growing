def verify_youtube_url(url: str) -> tuple[bool, str]:
    """Verifies a YouTube watch URL exists and is public via YouTube's official oEmbed API."""
    if not url or "youtube.com/results" in url or "watch?v=" not in url and "youtu.be/" not in url:
        return False, "Not a direct YouTube video link (must be watch?v=... or youtu.be/...)"
    oembed_url = f"https://www.youtube.com/oembed?url={urllib.parse.quote(url, safe='')}&format=json"
    req = urllib.request.Request(oembed_url, headers={"User-Agent": "Mozilla/5.0"})
    try:
        with urllib.request.urlopen(req, timeout=5) as resp:
            if resp.status == 200:
                data = json.loads(resp.read().decode("utf-8"))
                return True, f"{data.get('title')} — {data.get('author_name')}"
            return False, f"HTTP {resp.status}"
    except Exception as exc:
        return False, str(exc)


