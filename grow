def run_git(cmd_args: list[str]) -> tuple[int, str, str]:
    proc = subprocess.run(
        ["git", *cmd_args],
        cwd=ROOT_DIR,
        capture_output=True,
        text=True,
    )
    return proc.returncode, proc.stdout.strip(), proc.stderr.strip()


def sync_persisted_state(pull_first: bool = True, commit_msg: str | None = None) -> bool:
    active_user = get_active_user()
    if not is_persisted_user(active_user):
        print(
            f"\n{YELLOW}⚠️  Git cross-device persistence is exclusively enabled for user `{PERSISTED_USER}` "
            f"(current user: `{active_user}`).{RESET}"
        )
        print(f"  • Your progress is saved locally in `{get_state_file().relative_to(ROOT_DIR)}` (gitignored).")
        print(f"  • If you are {PERSISTED_USER.title()} on a new machine, run: {CYAN}grow user set {PERSISTED_USER}{RESET}\n")
        return False

    if not (ROOT_DIR / ".git").exists():
        print(f"\n{YELLOW}⚠️  `{ROOT_DIR}` is not a Git repository yet. Run `git init` first.{RESET}\n")
        return False

    state_file = get_state_file(PERSISTED_USER)
    rel_state = str(state_file.relative_to(ROOT_DIR))

    rc_rem, remote_url, _ = run_git(["remote", "get-url", "origin"])
    has_remote = rc_rem == 0 and bool(remote_url)

    print(f"\n{BOLD}{BLUE}🔄 Syncing `{PERSISTED_USER}` progress ({rel_state})...{RESET}")

    if pull_first and has_remote:
        rc_pull, out_pull, err_pull = run_git(["pull", "--rebase", "--autostash"])
        if rc_pull == 0:
            print(f"  {GREEN}✔{RESET} Pulled latest remote changes from `origin`.")
        else:
            print(f"  {YELLOW}⚠️  Git pull note:{RESET} {err_pull or out_pull}")

    run_git(["add", "-f", rel_state])
    rc_diff, _, _ = run_git(["diff", "--cached", "--quiet", "--", rel_state])
    if rc_diff != 0:
        state = load_state()
        track_id, _, progress = get_active_track_And_progress(state)
        msg = commit_msg or (
            f"chore(progress): sync {PERSISTED_USER} state "
            f"({track_id} day {progress.get('current_day', 1)}, {progress.get('xp', 0)} XP, streak {progress.get('current_streak', 0)})"
        )
        rc_c, out_c, err_c = run_git(["commit", "-m", msg, "--", rel_state])
        if rc_c == 0:
            print(f"  {GREEN}✔{RESET} Committed `{rel_state}`: {DIM}{msg}{RESET}")
        else:
            print(f"  {RED}✘ Commit failed:{RESET} {err_c or out_c}")
            return False
    else:
        print(f"  {GREEN}✔{RESET} `{rel_state}` is already clean and committed.")

    if has_remote:
        rc_push, out_push, err_push = run_git(["push"])
        if rc_push != 0:
            _, branch, _ = run_git(["branch", "--show-current"])
            branch = branch or "main"
            rc_push, out_push, err_push = run_git(["push", "-u", "origin", branch])
        if rc_push == 0:
            print(f"  {GREEN}🚀 Pushed `{PERSISTED_USER}` progress to `{remote_url}`!{RESET}\n")
            return True
        else:
            print(f"  {YELLOW}⚠️  Committed locally, but push to `{remote_url}` failed:{RESET} {err_push or out_push}\n")
            return False
    else:
        print(
            f"  {YELLOW}ℹ️  Committed locally.{RESET} Add a Git remote (`git remote add origin <url>`) "
            f"to push across devices.\n"
        )
        return True


